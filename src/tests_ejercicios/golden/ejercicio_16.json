   "index": 4,
   "source": "#| echo: False",
   "vars": {
    "pregunta_1": "1. Dibuje el grafo PERT del proyecto.  ",
    "pregunta_2": "2. Determine las ecuaciones de los tiempos tempranos de cada nodo.  ",
    "pregunta_3": "3. Calcule, utilizando las ecuaciones, los tiempos tempranos de cada nodo para 1000 iteraciones del método de MonteCarlo.  ",
    "pregunta_4": "4. Determina la duración media y la desviación típica de la duración del proyecto.  ",
    "pregunta_5": "5. Determine la duración para una probabilidad de completar antes el proyecto del 98%.  "
   }
